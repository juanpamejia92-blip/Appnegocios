<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <!-- CSP: Política de Seguridad -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval';">
    <title>Sistema de Pedidos Pro</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#fff7ed', 100: '#ffedd5', 500: '#f97316', 600: '#ea580c' },
                        surface: '#FCFCFC',
                        surface2: '#F3F4F6'
                    },
                    boxShadow: {
                        'premium': '0 10px 40px -10px rgba(0,0,0,0.08)',
                        'floating': '0 20px 40px -15px rgba(0,0,0,0.15)',
                        'glass': '0 8px 32px 0 rgba(31, 38, 135, 0.05)'
                    }
                }
            }
        }
    </script>

    <style>
        :root { -webkit-tap-highlight-color: transparent; }
        body { background-color: #F9FAFB; color: #171717; font-family: 'Plus Jakarta Sans', sans-serif; overflow-x: hidden; }
        
        /* Contenedor Web Responsivo (Eliminando el límite de celular) */
        .app-container { 
            width: 100%; 
            margin: 0 auto; 
            background-color: transparent; 
            min-height: 100vh; 
            position: relative; 
            overflow-x: hidden;
        }

        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        /* Animaciones UI Expertas */
        .fade-in { animation: fadeIn 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }
        .slide-up { animation: slideUp 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }
        .scale-in { animation: scaleIn 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }
        
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes scaleIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
        
        /* Efecto Glass */
        .glass { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid rgba(0,0,0,0.05); }
        .glass-dark { background: rgba(23, 23, 23, 0.85); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); }

        /* Componentes Custom */
        .btn-fluid { transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.2s; }
        .btn-fluid:active { transform: scale(0.96); }
        
        .pill-tab { transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); }
        .pill-tab.active { background-color: #171717; color: white; border-color: #171717; }
        
        /* Admin Dark Theme */
        .saas-theme { background-color: #0A0A0A; color: #FAFAFA; }
        .saas-card { background: #121212; border: 1px solid rgba(255,255,255,0.08); transition: border-color 0.3s; }
        .saas-card:hover { border-color: rgba(255,255,255,0.15); }
    </style>
</head>
<body class="selection:bg-brand-100 selection:text-brand-600">

    <div id="client-view" class="app-container">
        
        <!-- Header Minimalista Responsivo -->
        <header id="client-header" class="glass sticky top-0 z-40 px-6 py-5 flex justify-between items-center transition-all border-b border-neutral-100">
            <div class="flex items-center gap-3 max-w-7xl mx-auto w-full justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-neutral-100 flex items-center justify-center text-neutral-900 shadow-inner">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <div>
                        <p class="text-[10px] text-neutral-400 font-bold uppercase tracking-widest mb-0.5">Entregar en</p>
                        <div class="flex items-center gap-2 cursor-pointer group">
                            <span class="font-extrabold text-sm text-neutral-900 group-hover:text-brand-500 transition-colors" id="header-location-text">Mesa / Local</span>
                            <i class="fa-solid fa-chevron-down text-[10px] text-neutral-400"></i>
                        </div>
                    </div>
                </div>
                
                <div class="bg-neutral-100 rounded-full p-1 flex">
                    <button onclick="setOrderMode('mesa')" id="btn-mode-mesa" class="px-4 py-1.5 rounded-full text-[11px] font-bold bg-white text-neutral-900 shadow-sm transition-all z-10">Mesa</button>
                    <button onclick="setOrderMode('domicilio')" id="btn-mode-domicilio" class="px-4 py-1.5 rounded-full text-[11px] font-bold text-neutral-500 transition-all z-10 hover:text-neutral-900">Delivery</button>
                </div>
            </div>
        </header>

        <!-- Menu / Tienda -->
        <main id="view-menu" class="fade-in pb-32">
            <!-- Categorías Flotantes -->
            <div class="px-6 py-4 sticky top-[72px] bg-[#F9FAFB]/95 backdrop-blur-md z-30 mb-2 border-b border-neutral-100/50">
                <div id="category-tabs" class="flex gap-2.5 overflow-x-auto no-scrollbar py-1 max-w-7xl mx-auto md:justify-center">
                    <!-- JS Inyecta las categorías -->
                </div>
            </div>

            <!-- Grid Responsivo para Platos -->
            <div class="px-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8 max-w-7xl mx-auto mt-6" id="menu-items-container">
                <!-- JS Inyecta los productos -->
            </div>
        </main>

        <main id="view-checkout" class="hidden fade-in px-6 py-10 pb-32 bg-transparent min-h-full max-w-3xl mx-auto">
            <div class="flex items-center gap-4 mb-8">
                <button onclick="openMenu()" class="w-10 h-10 bg-neutral-100 hover:bg-neutral-200 rounded-full flex items-center justify-center text-neutral-900 transition-colors btn-fluid">
                    <i class="fa-solid fa-arrow-left"></i>
                </button>
                <h2 class="text-3xl font-black text-neutral-900 tracking-tight">Tu Orden</h2>
            </div>
            
            <!-- Items Carrito -->
            <div id="cart-items" class="mb-8 flex flex-col gap-4">
                <!-- JS inyecta items -->
            </div>

            <!-- Resumen Pago -->
            <div class="bg-neutral-50 p-6 rounded-[24px] mb-8 border border-neutral-100/80">
                <div class="flex justify-between mb-3 text-sm font-medium text-neutral-500"><span>Subtotal</span><span id="checkout-subtotal" class="text-neutral-900">$0</span></div>
                <div class="flex justify-between mb-4 text-sm font-medium text-neutral-500"><span>Costo de Envío</span><span id="checkout-shipping" class="text-neutral-900">Gratis</span></div>
                <div class="w-full h-px bg-neutral-200 mb-4"></div>
                <div class="flex justify-between font-black text-xl">
                    <span class="text-neutral-900">Total</span><span id="checkout-total" class="text-brand-500">$0</span>
                </div>
            </div>

            <!-- Formulario Datos -->
            <form id="checkout-form" class="space-y-4" onsubmit="openWompiModal(event)">
                <h3 class="font-extrabold text-neutral-900 text-lg mb-2">Detalles de entrega</h3>
                <div class="space-y-3">
                    <input type="text" id="cust-name" required placeholder="Tu Nombre Completo" class="w-full bg-neutral-50 border border-neutral-200 p-4 rounded-2xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 outline-none transition-all text-sm font-medium">
                    <input type="tel" id="cust-phone" required placeholder="WhatsApp (Ej: 300 123 4567)" class="w-full bg-neutral-50 border border-neutral-200 p-4 rounded-2xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 outline-none transition-all text-sm font-medium">
                    <div id="dynamic-location-input">
                        <input type="text" id="cust-location" required placeholder="Número de Mesa" class="w-full bg-neutral-50 border border-neutral-200 p-4 rounded-2xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 outline-none transition-all text-sm font-medium">
                    </div>
                </div>
                
                <button type="submit" class="w-full bg-neutral-900 text-white py-4.5 p-4 rounded-2xl font-bold flex justify-center items-center gap-2 mt-8 btn-fluid">
                    Pagar con <span class="font-black tracking-tighter text-lg ml-1">Wompi</span>
                </button>
            </form>
        </main>

        <main id="view-tracking" class="hidden fade-in px-6 py-12 bg-transparent min-h-full max-w-3xl mx-auto">
            <div class="text-center mb-10">
                <div class="inline-flex items-center justify-center w-20 h-20 bg-green-100 text-green-600 rounded-full mb-6 shadow-sm">
                    <i class="fa-solid fa-check text-4xl"></i>
                </div>
                <h2 class="text-3xl font-black mb-1 text-neutral-900 tracking-tight">¡Orden Confirmada!</h2>
                <p class="text-neutral-500 text-sm font-medium">Ticket #<span id="track-order-id" class="font-bold text-neutral-900"></span></p>
            </div>

            <!-- Mapa Minimalista -->
            <div id="live-map-container" class="hidden w-full h-48 rounded-[24px] bg-neutral-50 relative border border-neutral-200 mb-8 overflow-hidden">
                <svg class="absolute inset-0 w-full h-full opacity-20" viewBox="0 0 350 150" preserveAspectRatio="none">
                    <path d="M-20,100 C 100,100 150,20 250,50 S 350,120 400,100" fill="none" stroke="#171717" stroke-width="2" stroke-dasharray="4,4" stroke-linecap="round" />
                </svg>
                <div id="gps-bike" class="absolute w-12 h-12 bg-neutral-900 rounded-full shadow-lg flex items-center justify-center text-xl text-white z-10 transition-all duration-1000 ease-in-out border-4 border-white" style="left: 10px; top: 70px;">
                    <i class="fa-solid fa-motorcycle text-sm"></i>
                </div>
                <div class="absolute left-4 top-16 w-8 h-8 bg-neutral-200 text-neutral-600 rounded-full flex items-center justify-center z-0 border-2 border-white">
                    <i class="fa-solid fa-store text-[10px]"></i>
                </div>
                <div class="absolute right-4 top-16 w-8 h-8 bg-brand-500 text-white rounded-full flex items-center justify-center z-0 border-2 border-white shadow-md">
                    <i class="fa-solid fa-house text-[10px]"></i>
                </div>
                
                <button onclick="toggleChat()" class="absolute bottom-3 right-3 bg-white/90 backdrop-blur text-neutral-900 px-4 py-2 rounded-full font-bold shadow-sm text-xs flex items-center gap-2 border border-neutral-200 hover:bg-neutral-50 btn-fluid">
                    <i class="fa-solid fa-message text-brand-500"></i> Repartidor
                </button>
            </div>

            <!-- Timeline Elegante -->
            <div class="bg-white p-6 rounded-[24px] border border-neutral-100 shadow-premium">
                <h3 class="font-bold text-lg mb-6 text-neutral-900">Estado del envío</h3>
                
                <div class="relative pl-6 border-l-2 border-neutral-100 space-y-8" id="tracking-timeline">
                    <div class="relative" id="step-pending">
                        <div class="absolute -left-[35px] w-4 h-4 bg-white border-4 border-brand-500 rounded-full"></div>
                        <p class="font-extrabold text-neutral-900 text-sm">Pendiente de Confirmación</p>
                        <p class="text-[13px] text-neutral-500 mt-0.5">El restaurante está verificando tu pago.</p>
                    </div>
                    <div class="relative opacity-40" id="step-prep">
                        <div class="absolute -left-[35px] w-4 h-4 bg-neutral-200 rounded-full"></div>
                        <p class="font-extrabold text-neutral-900 text-sm">En Preparación</p>
                        <p class="text-[13px] text-neutral-500 mt-0.5">Nuestros chefs están trabajando.</p>
                    </div>
                    <div class="relative opacity-40" id="step-ready">
                        <div class="absolute -left-[35px] w-4 h-4 bg-neutral-200 rounded-full"></div>
                        <p class="font-extrabold text-neutral-900 text-sm" id="track-step3-title">Despachado</p>
                        <p class="text-[13px] text-neutral-500 mt-0.5" id="track-step3-desc">¡Va en camino!</p>
                    </div>
                </div>
            </div>
            
            <button onclick="startNewOrder()" class="mt-8 w-full bg-neutral-100 text-neutral-900 font-bold py-4 rounded-2xl hover:bg-neutral-200 transition-colors btn-fluid">
                Hacer otro pedido
            </button>
        </main>

        <!-- Floating Bottom Bar -->
        <div id="client-bottom-nav" class="fixed bottom-6 left-1/2 -translate-x-1/2 w-[calc(100%-3rem)] max-w-[380px] glass-dark text-white rounded-full p-2 pl-6 flex justify-between items-center z-50 shadow-floating scale-in hidden">
            <div class="flex items-center gap-4">
                <div class="relative">
                    <i class="fa-solid fa-basket-shopping text-neutral-400"></i>
                    <span id="cart-badge" class="absolute -top-3 -right-3 bg-brand-500 text-white text-[10px] font-bold w-5 h-5 flex items-center justify-center rounded-full hidden">0</span>
                </div>
                <div class="flex flex-col">
                    <span class="text-[10px] text-neutral-400 font-bold uppercase tracking-wider">Total</span>
                    <span class="text-sm font-bold text-white leading-none" id="nav-total">$0</span>
                </div>
            </div>
            <button onclick="openCheckout()" class="bg-white text-neutral-900 px-6 py-2.5 rounded-full font-bold text-sm btn-fluid">
                Ver Orden
            </button>
        </div>

        <!-- Botón Acceso Admin -->
        <button onclick="toggleAppMode()" class="fixed top-24 right-0 bg-neutral-900 text-white px-4 py-2.5 rounded-l-xl z-20 hover:bg-black transition-all flex items-center gap-2 text-[11px] font-bold shadow-floating">
            <i class="fa-solid fa-terminal text-brand-500"></i> Panel Negocios
        </button>
    </div>

    <!-- PANTALLA LOGIN TIPO LANDING PAGE SAAS -->
    <div id="admin-login-view" class="hidden fixed inset-0 z-[300] bg-white flex fade-in overflow-hidden">
        
        <!-- Lado Izquierdo: Ventas y Marketing (Oculto en Móviles) -->
        <div class="hidden lg:flex lg:w-1/2 bg-neutral-900 p-12 flex-col justify-between relative overflow-hidden">
            <div class="absolute -top-40 -left-40 w-[500px] h-[500px] bg-brand-500/20 rounded-full blur-[100px]"></div>
            <div class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-blue-500/10 rounded-full blur-[120px]"></div>
            
            <div class="relative z-10 mt-10">
                <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-2xl text-neutral-900 mb-8 shadow-xl">
                    <i class="fa-solid fa-bolt"></i>
                </div>
                <h1 class="text-5xl lg:text-6xl font-black text-white tracking-tight mb-6 leading-tight">RestoOS<br>Commerce.</h1>
                <p class="text-neutral-400 text-xl font-medium max-w-md leading-relaxed">El sistema de autogestión de pedidos que multiplica las ventas de tu restaurante. Sin comisiones por venta.</p>
            </div>
            
            <div class="relative z-10 bg-white/5 border border-white/10 p-6 rounded-3xl backdrop-blur-md max-w-md mt-10">
                <div class="flex items-center gap-4 mb-4">
                    <div class="flex -space-x-3">
                        <img src="https://i.pravatar.cc/100?img=33" class="w-10 h-10 rounded-full border-2 border-neutral-900">
                        <img src="https://i.pravatar.cc/100?img=47" class="w-10 h-10 rounded-full border-2 border-neutral-900">
                        <img src="https://i.pravatar.cc/100?img=12" class="w-10 h-10 rounded-full border-2 border-neutral-900">
                    </div>
                    <div class="text-sm font-bold text-white">Únete a +500 negocios</div>
                </div>
                <p class="text-sm text-neutral-400 italic font-medium">"Desde que usamos RestoOS, nuestros pedidos por WhatsApp se gestionan solos y nuestras ventas subieron un 40%."</p>
            </div>
        </div>

        <!-- Lado Derecho: Formularios -->
        <div class="w-full lg:w-1/2 flex items-center justify-center p-6 sm:p-12 relative overflow-y-auto bg-surface">
            <button onclick="closeLogin()" class="absolute top-6 right-6 w-10 h-10 flex items-center justify-center rounded-full bg-neutral-100 text-neutral-400 hover:text-neutral-900 hover:bg-neutral-200 transition-colors z-20"><i class="fa-solid fa-times"></i></button>
            
            <div class="max-w-[400px] w-full relative z-10 scale-in pt-10 lg:pt-0">
                
                <!-- Logo versión Móvil -->
                <div class="w-12 h-12 bg-neutral-900 rounded-[14px] flex lg:hidden items-center justify-center text-xl text-white mb-6 shadow-md">
                    <i class="fa-solid fa-bolt"></i>
                </div>
                <h2 class="text-3xl font-black text-neutral-900 tracking-tight mb-2 lg:hidden">RestoOS.</h2>
                
                <div id="auth-forms-container">
                        <input type="email" id="reg-email" placeholder="Correo electrónico" class="w-full bg-neutral-50 border border-neutral-200 px-4 py-3 rounded-xl focus:border-neutral-900 outline-none text-sm" required>
                        <input type="text" id="reg-user" placeholder="Usuario (para login)" class="w-full bg-neutral-50 border border-neutral-200 px-4 py-3 rounded-xl focus:border-neutral-900 outline-none text-sm" required>
                        <input type="password" id="reg-pass" placeholder="Contraseña" class="w-full bg-neutral-50 border border-neutral-200 px-4 py-3 rounded-xl focus:border-neutral-900 outline-none text-sm" required>
                        
                        <div class="bg-brand-50 p-3 rounded-xl border border-brand-100 mt-2">
                            <p class="text-[11px] text-brand-600 font-semibold">🎁 Obtienes 14 días gratis. Luego $50.000 COP/mes.</p>
                        </div>

                        <button type="submit" class="w-full bg-brand-500 text-white font-bold py-3.5 rounded-xl hover:bg-brand-600 transition-colors btn-fluid mt-4 text-sm">
                            Comenzar Prueba
                        </button>
                    </form>
                    <button onclick="switchAuthView('login')" class="w-full text-center text-xs font-bold text-neutral-500 mt-6 hover:text-neutral-900">Ya tengo cuenta</button>
                </div>

                <!-- Recuperar -->
                <div id="form-recover" class="fade-in hidden">
                    <p class="text-sm text-neutral-500 mb-6 font-medium">Te enviaremos un enlace mágico.</p>
                    <form onsubmit="processRecovery(event)" class="space-y-4">
                        <input type="email" id="rec-email" placeholder="Tu correo electrónico" class="w-full bg-neutral-50 border border-neutral-200 px-4 py-3.5 rounded-2xl focus:border-neutral-900 outline-none text-sm font-medium" required>
                        
                        <div id="recover-success" class="hidden bg-green-50 text-green-700 p-3 rounded-xl text-xs font-bold text-center border border-green-100">
                            Enlace enviado.
                        </div>
                        <button type="submit" class="w-full bg-neutral-900 text-white font-bold py-4 rounded-2xl hover:bg-black transition-colors btn-fluid">
                            Enviar Enlace
                        </button>
                    </form>
                    <button onclick="switchAuthView('login')" class="w-full text-center text-xs font-bold text-neutral-500 mt-6 hover:text-neutral-900">Volver</button>
                </div>
            </div>

            <button onclick="closeLogin()" class="absolute top-6 right-6 w-8 h-8 flex items-center justify-center rounded-full bg-neutral-100 text-neutral-400 hover:text-neutral-900 hover:bg-neutral-200 transition-colors"><i class="fa-solid fa-times text-sm"></i></button>
        </div>
    </div>

    <div id="admin-view" class="hidden min-h-screen bg-surface2 flex text-neutral-900">
        <!-- Sidebar -->
        <aside class="w-64 bg-white border-r border-neutral-200 flex flex-col z-10 sticky top-0 h-screen">
            <div class="p-6 border-b border-neutral-100">
                <div class="w-8 h-8 bg-neutral-900 rounded-lg flex items-center justify-center text-white mb-4 shadow-sm">
                    <i class="fa-solid fa-store text-xs"></i>
                </div>
                <h1 class="text-lg font-black tracking-tight" id="admin-restaurant-name">Restaurante</h1>
                <p class="text-[10px] text-neutral-400 font-bold uppercase tracking-widest mt-1">Workspace</p>
            </div>
            
            <nav class="p-4 flex-1 space-y-1">
                <button onclick="switchAdminTab('pedidos')" id="tab-admin-pedidos" class="w-full text-left px-4 py-2.5 bg-neutral-100 text-neutral-900 rounded-xl font-bold text-sm transition flex items-center gap-3"><i class="fa-solid fa-inbox w-4 text-center opacity-70"></i> Pedidos</button>
                <button onclick="switchAdminTab('menu')" id="tab-admin-menu" class="w-full text-left px-4 py-2.5 text-neutral-500 hover:text-neutral-900 hover:bg-neutral-50 rounded-xl font-bold text-sm transition flex items-center gap-3"><i class="fa-solid fa-layer-group w-4 text-center opacity-70"></i> Menú</button>
                <button onclick="switchAdminTab('billing')" id="tab-admin-billing" class="w-full text-left px-4 py-2.5 text-neutral-500 hover:text-neutral-900 hover:bg-neutral-50 rounded-xl font-bold text-sm transition flex items-center gap-3"><i class="fa-solid fa-credit-card w-4 text-center opacity-70"></i> Suscripción</button>
            </nav>
            
            <div class="p-4 border-t border-neutral-100 space-y-2">
                <button onclick="toggleAppMode()" class="w-full text-left px-4 py-2 text-neutral-500 hover:text-neutral-900 text-xs font-bold transition flex items-center gap-3"><i class="fa-solid fa-mobile-screen w-4 text-center opacity-70"></i> Ver App</button>
                <button onclick="logoutAdmin()" class="w-full text-left px-4 py-2 text-red-500 hover:bg-red-50 rounded-lg text-xs font-bold transition flex items-center gap-3"><i class="fa-solid fa-power-off w-4 text-center opacity-70"></i> Salir</button>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 p-8 h-screen overflow-y-auto">
            
            <!-- Dashboard Kanban (Pedidos) -->
            <div id="admin-content-pedidos" class="fade-in max-w-6xl mx-auto">
                <div class="mb-8">
                    <h2 class="text-2xl font-black tracking-tight">Monitor en Vivo</h2>
                    <p class="text-sm text-neutral-500 font-medium">Gestión de órdenes operativas.</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Columna -->
                    <div class="bg-neutral-100/50 rounded-3xl p-2 border border-neutral-200 border-dashed">
                        <div class="px-3 py-3 flex justify-between items-center">
                            <span class="text-xs font-bold uppercase tracking-widest text-neutral-500 flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-brand-500"></div> Nuevos</span>
                        </div>
                        <div id="col-pending" class="space-y-3 min-h-[200px]"></div>
                    </div>
                    
                    <div class="bg-neutral-100/50 rounded-3xl p-2 border border-neutral-200 border-dashed">
                        <div class="px-3 py-3 flex justify-between items-center">
                            <span class="text-xs font-bold uppercase tracking-widest text-neutral-500 flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-blue-500"></div> Cocina</span>
                        </div>
                        <div id="col-prep" class="space-y-3 min-h-[200px]"></div>
                    </div>
                    
                    <div class="bg-neutral-100/50 rounded-3xl p-2 border border-neutral-200 border-dashed">
                        <div class="px-3 py-3 flex justify-between items-center">
