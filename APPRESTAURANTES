    <script>
        // Utilidades de Seguridad (Anti XSS & Hashing sim.)
        function sanitizeHTML(str) { return str ? str.replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)) : ''; }
        async function hashPassword(password) {
            const msgBuffer = new TextEncoder().encode(password);
            const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
            return Array.from(new Uint8Array(hashBuffer)).map(b => b.toString(16).padStart(2, '0')).join('');
        }

        // Modales
        function showModal(title, text, iconClass, iconBgClass) {
            document.getElementById('modal-title').textContent = title;
            document.getElementById('modal-text').textContent = text;
            const iconContainer = document.getElementById('modal-icon-container');
            iconContainer.className = `w-14 h-14 rounded-full flex items-center justify-center text-xl mx-auto mb-4 ${iconBgClass}`;
            document.getElementById('modal-icon').className = iconClass;
            document.getElementById('general-modal').classList.remove('hidden');
        }
        function closeModal() { document.getElementById('general-modal').classList.add('hidden'); }

        // Estado Global (DB Mock)
        let saasRestaurants = [
            { id: 'r1', name: 'Burger Pro', user: 'admin', status: 'active', plan: 'Pro', mrr: 50000, joined: 'Hoy' },
            { id: 'r2', name: 'Pizza Roma', user: 'pizzaroma', status: 'suspended', plan: 'Pro', mrr: 50000, joined: 'Ayer' }
        ];

        let dbCategories = [{ id: 'cat_1', name: 'Combos' }, { id: 'cat_2', name: 'Bebidas' }];
        let dbMenu = [
            { id: 'p_1', categoryId: 'cat_1', name: 'Smash Burger Doble', desc: 'Doble carne, queso cheddar fundido y pan brioche.', price: 25000, img: 'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=300&q=80' },
            { id: 'p_2', categoryId: 'cat_1', name: 'Crispy Chicken', desc: 'Pollo frito extracrujiente con salsa secreta.', price: 22000, img: 'https://images.unsplash.com/photo-1606755962773-d324e0a13086?auto=format&fit=crop&w=300&q=80' },
            { id: 'p_3', categoryId: 'cat_2', name: 'Limonada Cereza', desc: 'Refrescante limonada natural con cereza.', price: 6000, img: 'https://images.unsplash.com/photo-1513558161293-cdaf765ed2fd?auto=format&fit=crop&w=300&q=80' }
        ];

        let cart = JSON.parse(localStorage.getItem('resto_pro_cart')) || [];
        let globalOrders = []; 
        let currentOrderId = null;
        let loggedInRole = null; 
        
        let appState = { viewMode: 'client', orderMode: 'mesa', wompiMode: 'order' };
        let clientCurrentCategory = 'all';

        function renderClientMenu() {
            const tabs = document.getElementById('category-tabs');
            tabs.innerHTML = `<button onclick="setCategory('all')" class="px-6 py-2.5 rounded-full text-xs font-bold whitespace-nowrap border pill-tab ${clientCurrentCategory === 'all' ? 'active shadow-md' : 'border-neutral-200 bg-white text-neutral-600 hover:bg-neutral-50'}">Todo</button>`;
            
            dbCategories.forEach(cat => {
                const isActive = clientCurrentCategory === cat.id;
                tabs.innerHTML += `<button onclick="setCategory('${cat.id}')" class="px-6 py-2.5 rounded-full text-xs font-bold whitespace-nowrap border pill-tab ${isActive ? 'active shadow-md' : 'border-neutral-200 bg-white text-neutral-600 hover:bg-neutral-50'}">${cat.name}</button>`;
            });

            const container = document.getElementById('menu-items-container');
            container.innerHTML = '';
            
            const filteredMenu = clientCurrentCategory === 'all' ? dbMenu : dbMenu.filter(p => p.categoryId === clientCurrentCategory);
            
            filteredMenu.forEach(item => {
                const imgSrc = item.img || `https://placehold.co/300x300/f3f4f6/9ca3af?text=No+Foto`;
                // Adaptado visualmente para Desktop y Móvil (Estilo Tarjeta)
                container.innerHTML += `
                    <div class="flex gap-4 group bg-white p-4 rounded-3xl shadow-sm border border-neutral-100/80 hover:shadow-premium transition-all duration-300 hover:border-neutral-200">
                        <div class="flex-1 flex flex-col justify-center py-1">
                            <h3 class="font-extrabold text-neutral-900 text-lg leading-tight mb-1 group-hover:text-brand-600 transition-colors">${item.name}</h3>
                            <p class="text-[13px] text-neutral-500 font-medium line-clamp-2 mb-3 leading-relaxed">${item.desc}</p>
                            <div class="flex justify-between items-center mt-auto">
                                <span class="font-black text-neutral-900 text-lg">$${item.price.toLocaleString('es-CO')}</span>
                            </div>
                        </div>
                        <div class="relative w-[110px] h-[110px] sm:w-[130px] sm:h-[130px] shrink-0">
                            <img src="${imgSrc}" class="w-full h-full object-cover rounded-[22px] shadow-sm">
                            <button onclick="addToCart('${item.id}')" class="absolute -bottom-2 -right-2 bg-neutral-900 text-white w-10 h-10 rounded-full shadow-lg flex items-center justify-center btn-fluid border-[3px] border-white hover:bg-brand-500 transition-colors">
                                <i class="fa-solid fa-plus text-sm"></i>
                            </button>
                        </div>
                    </div>`;
            });
        }

        function setCategory(id) { clientCurrentCategory = id; renderClientMenu(); }
        
        function setOrderMode(mode) {
            appState.orderMode = mode;
            const btnMesa = document.getElementById('btn-mode-mesa');
            const btnDom = document.getElementById('btn-mode-domicilio');
            const inputLoc = document.getElementById('dynamic-location-input');
            const headerText = document.getElementById('header-location-text');
            
            if(mode === 'mesa') {
                btnMesa.className = "px-4 py-1.5 rounded-full text-[11px] font-bold bg-white text-neutral-900 shadow-sm transition-all z-10";
                btnDom.className = "px-4 py-1.5 rounded-full text-[11px] font-bold text-neutral-500 transition-all z-10 hover:text-neutral-900";
                headerText.textContent = "Mesa / Local";
                inputLoc.innerHTML = `<input type="text" id="cust-location" required placeholder="Número de Mesa" class="w-full bg-neutral-50 border border-neutral-200 p-4 rounded-2xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 outline-none transition-all text-sm font-medium">`;
            } else {
                btnDom.className = "px-4 py-1.5 rounded-full text-[11px] font-bold bg-white text-neutral-900 shadow-sm transition-all z-10";
                btnMesa.className = "px-4 py-1.5 rounded-full text-[11px] font-bold text-neutral-500 transition-all z-10 hover:text-neutral-900";
                headerText.textContent = "Domicilio";
                inputLoc.innerHTML = `<input type="text" id="cust-location" required placeholder="Dirección Completa" class="w-full bg-neutral-50 border border-neutral-200 p-4 rounded-2xl focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 outline-none transition-all text-sm font-medium">`;
            }
            updateCartUI();
        }

        function addToCart(id) {
            const product = dbMenu.find(p => p.id === id);
            if(!product) return;
            const existing = cart.find(item => item.id === id);
            if(existing) existing.qty += 1; else cart.push({ ...product, qty: 1 });
            localStorage.setItem('resto_pro_cart', JSON.stringify(cart));
            updateCartUI();
        }

        function updateCartUI() {
            const badge = document.getElementById('cart-badge');
            const nav = document.getElementById('client-bottom-nav');
            const totalItems = cart.reduce((sum, item) => sum + item.qty, 0);
            
            if(totalItems > 0 && appState.viewMode === 'client' && document.getElementById('view-menu').classList.contains('hidden') === false) { 
                badge.textContent = totalItems; badge.classList.remove('hidden'); 
                nav.classList.remove('hidden');
            } else { 
                badge.classList.add('hidden'); nav.classList.add('hidden');
            }

            let subtotal = 0;
            const cartContainer = document.getElementById('cart-items');
            if(cartContainer) {
                cartContainer.innerHTML = '';
                cart.forEach(item => {
                    const lineTotal = Math.max(0, item.price) * Math.max(1, item.qty);
                    subtotal += lineTotal;
                    cartContainer.innerHTML += `
                        <div class="flex items-center justify-between border-b border-neutral-100 pb-3">
                            <div class="flex items-center gap-3">
                                <span class="bg-neutral-100 text-neutral-600 text-[11px] font-black px-2 py-1 rounded-md">${item.qty}x</span>
                                <span class="font-extrabold text-sm text-neutral-900">${item.name}</span>
                            </div>
                            <div class="font-black text-neutral-900 text-sm">$${lineTotal.toLocaleString('es-CO')}</div>
                        </div>`;
                });
            }

            const shipping = appState.orderMode === 'domicilio' ? 5000 : 0;
            const finalTotal = subtotal + shipping;
            
            document.getElementById('nav-total').textContent = `$${subtotal.toLocaleString('es-CO')}`;
            if(document.getElementById('checkout-subtotal')) {
                document.getElementById('checkout-subtotal').textContent = `$${subtotal.toLocaleString('es-CO')}`;
                document.getElementById('checkout-shipping').textContent = shipping > 0 ? `$${shipping.toLocaleString('es-CO')}` : 'Gratis';
                document.getElementById('checkout-total').textContent = `$${finalTotal.toLocaleString('es-CO')}`;
                document.getElementById('wompi-amount').textContent = `$${finalTotal.toLocaleString('es-CO')}`;
            }
        }

        function openCheckout() {
            document.getElementById('view-menu').classList.add('hidden');
            document.getElementById('client-bottom-nav').classList.add('hidden');
            document.getElementById('view-checkout').classList.remove('hidden');
        }
        function openMenu() {
            document.getElementById('view-checkout').classList.add('hidden');
            document.getElementById('view-menu').classList.remove('hidden');
            updateCartUI();
        }

        function openWompiModal(e) {
            e.preventDefault();
            if(!document.getElementById('cust-name').value || !document.getElementById('cust-location').value) return;
            appState.wompiMode = 'order';
            document.getElementById('wompi-modal').classList.remove('hidden');
        }

        function processWompiPayment() {
            const btn = document.getElementById('btn-process-wompi');
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-white"></i>'; btn.disabled = true;

            setTimeout(() => {
                document.getElementById('wompi-modal').classList.add('hidden');
                btn.innerHTML = 'Pagar Ahora <i class="fa-solid fa-lock text-[10px]"></i>'; btn.disabled = false;
                if(appState.wompiMode === 'order') submitOrderAfterPayment();
                else if(appState.wompiMode === 'subscription') successSubscriptionPayment();
            }, 1500);
        }

        function submitOrderAfterPayment() {
            const name = sanitizeHTML(document.getElementById('cust-name').value);
            const phone = sanitizeHTML(document.getElementById('cust-phone').value);
            const location = sanitizeHTML(document.getElementById('cust-location').value);
            const subtotal = cart.reduce((sum, item) => sum + (Math.max(0, item.price) * Math.max(1, item.qty)), 0);
            const total = appState.orderMode === 'domicilio' ? subtotal + 5000 : subtotal;

            const newOrder = { id: Math.floor(1000 + Math.random() * 9000).toString(), mode: appState.orderMode, customer: name, location: location, items: [...cart], total: total, status: 'pending' };
            globalOrders.push(newOrder); currentOrderId = newOrder.id;
            
            cart = []; localStorage.removeItem('resto_pro_cart'); updateCartUI();
            
            document.getElementById('view-checkout').classList.add('hidden');
            document.getElementById('client-header').classList.add('hidden');
            document.getElementById('view-tracking').classList.remove('hidden');
            
            updateClientTrackingUI(); renderAdminDashboard(); 
        }

        function updateClientTrackingUI() {
            if(!currentOrderId) return;
            const order = globalOrders.find(o => o.id === currentOrderId);
            if(!order) return;

            document.getElementById('track-order-id').textContent = order.id;
            const sPending = document.getElementById('step-pending');
            const sPrep = document.getElementById('step-prep');
            const sReady = document.getElementById('step-ready');

            [sPending, sPrep, sReady].forEach(el => { el.classList.add('opacity-40'); el.querySelector('div').className = "absolute -left-[35px] w-4 h-4 bg-neutral-200 rounded-full"; });
            
            const activeClass = "absolute -left-[35px] w-4 h-4 bg-white border-4 border-brand-500 rounded-full";
            const doneClass = "absolute -left-[35px] w-4 h-4 bg-brand-500 rounded-full";

            if(order.status === 'pending') { sPending.classList.remove('opacity-40'); sPending.querySelector('div').className = activeClass; } 
            else if (order.status === 'prep') {
                sPending.classList.remove('opacity-40'); sPending.querySelector('div').className = doneClass;
                sPrep.classList.remove('opacity-40'); sPrep.querySelector('div').className = activeClass;
            } else if (order.status === 'ready') {
                sPending.classList.remove('opacity-40'); sPending.querySelector('div').className = doneClass;
                sPrep.classList.remove('opacity-40'); sPrep.querySelector('div').className = doneClass;
                sReady.classList.remove('opacity-40'); sReady.querySelector('div').className = activeClass;
                document.getElementById('track-step3-title').textContent = order.mode === 'domicilio' ? 'En Camino' : 'Listo en Barra';
                if(order.mode === 'domicilio') document.getElementById('live-map-container').classList.remove('hidden');
            }
        }

        function toggleChat() {
            const chat = document.getElementById('delivery-chat');
            chat.classList.toggle('translate-y-full');
        }
        function sendMessage() {
            const input = document.getElementById('chat-input');
            const safeMsg = sanitizeHTML(input.value.trim());
            if(!safeMsg) return;
            const chatBox = document.getElementById('chat-messages');
            chatBox.innerHTML += `<div class="self-end max-w-[80%] bg-brand-500 text-white rounded-2xl rounded-tr-sm px-4 py-3 text-sm font-medium fade-in">${safeMsg}</div>`;
            input.value = ''; setTimeout(() => { chatBox.scrollTop = chatBox.scrollHeight; }, 10);
        }
        function startNewOrder() {
            document.getElementById('view-tracking').classList.add('hidden');
            document.getElementById('live-map-container').classList.add('hidden');
            document.getElementById('client-header').classList.remove('hidden');
            document.getElementById('view-menu').classList.remove('hidden');
            currentOrderId = null; updateCartUI();
        }

        function toggleAppMode() {
            if(appState.viewMode === 'client') {
                if(loggedInRole === 'admin') {
                    appState.viewMode = 'admin'; document.getElementById('client-view').classList.add('hidden'); document.getElementById('admin-view').classList.remove('hidden'); renderAdminDashboard();
                } else if (loggedInRole === 'superadmin') {
                    appState.viewMode = 'superadmin'; document.getElementById('client-view').classList.add('hidden'); document.getElementById('super-admin-view').classList.remove('hidden'); renderSuperAdminDashboard();
                } else {
                    document.getElementById('admin-login-view').classList.remove('hidden'); switchAuthView('login');
                }
            } else {
                appState.viewMode = 'client'; document.getElementById('admin-view').classList.add('hidden'); document.getElementById('super-admin-view').classList.add('hidden'); document.getElementById('client-view').classList.remove('hidden'); updateCartUI();
            }
        }

        function switchAuthView(view) {
            ['form-login', 'form-register', 'form-recover', 'login-error'].forEach(id => document.getElementById(id).classList.add('hidden'));
            document.getElementById(`form-${view}`).classList.remove('hidden');
        }
        function closeLogin() { document.getElementById('admin-login-view').classList.add('hidden'); }

        async function processLogin(e) {
            e.preventDefault();
            const user = sanitizeHTML(document.getElementById('login-user').value.toLowerCase());
            const pass = document.getElementById('login-pass').value;
            const errorBox = document.getElementById('login-error');
            const errorText = document.getElementById('login-error-text');

            if(user === 'owner' && pass === 'master') {
                loggedInRole = 'superadmin'; appState.viewMode = 'superadmin';
                document.getElementById('admin-login-view').classList.add('hidden'); document.getElementById('client-view').classList.add('hidden');
                document.getElementById('super-admin-view').classList.remove('hidden'); renderSuperAdminDashboard(); return;
            }

            const hash1234 = "03ac674216f3e15c761ee1a5e255f067953623c8b388b4459e13f978d7c846f4";
            const inputHash = await hashPassword(pass);
            const restaurant = saasRestaurants.find(r => r.user === user);

            if(restaurant && inputHash === hash1234) {
                if(restaurant.status === 'suspended') {
                    errorText.textContent = "Cuenta inactiva (Falta pago)."; errorBox.classList.remove('hidden'); return;
                }
                loggedInRole = 'admin'; appState.viewMode = 'admin';
                document.getElementById('admin-login-view').classList.add('hidden'); document.getElementById('client-view').classList.add('hidden');
                document.getElementById('admin-restaurant-name').textContent = restaurant.name;
                document.getElementById('admin-view').classList.remove('hidden');
                document.getElementById('login-pass').value = ''; switchAdminTab('pedidos');
            } else {
                errorText.textContent = "Credenciales inválidas."; errorBox.classList.remove('hidden');
            }
        }

        function logoutAdmin() { loggedInRole = null; toggleAppMode(); }

        // Kanban Operativo
        function switchAdminTab(tab) {
            ['pedidos', 'menu', 'billing'].forEach(t => {
                document.getElementById(`admin-content-${t}`).classList.add('hidden');
                document.getElementById(`tab-admin-${t}`).className = "w-full text-left px-4 py-2.5 text-neutral-500 hover:text-neutral-900 hover:bg-neutral-50 rounded-xl font-bold text-sm transition flex items-center gap-3";
            });
            document.getElementById(`admin-content-${tab}`).classList.remove('hidden');
            document.getElementById(`tab-admin-${tab}`).className = "w-full text-left px-4 py-2.5 bg-neutral-100 text-neutral-900 rounded-xl font-bold text-sm transition flex items-center gap-3";
            
            if(tab === 'pedidos') renderAdminDashboard();
            if(tab === 'menu') renderAdminMenuManager();
        }

        function renderAdminDashboard() {
            if(loggedInRole !== 'admin') return;
            ['col-pending', 'col-prep', 'col-ready'].forEach(id => document.getElementById(id).innerHTML = '');
            
            globalOrders.forEach(order => {
                const icon = order.mode === 'domicilio' ? '<i class="fa-solid fa-motorcycle text-brand-500"></i>' : '<i class="fa-solid fa-bell-concierge text-neutral-500"></i>';
                let actionBtn = '';
                if(order.status === 'pending') actionBtn = `<button onclick="updateOrderStatus('${order.id}', 'prep')" class="w-full bg-neutral-900 text-white text-xs font-bold py-2 rounded-lg mt-3 hover:bg-black btn-fluid">Preparar</button>`;
                if(order.status === 'prep') actionBtn = `<button onclick="updateOrderStatus('${order.id}', 'ready')" class="w-full bg-green-500 text-white text-xs font-bold py-2 rounded-lg mt-3 hover:bg-green-600 btn-fluid">Listo / Despachar</button>`;
                
                const cardHTML = `
                    <div class="bg-white p-4 rounded-[16px] shadow-sm border border-neutral-100 relative overflow-hidden group">
                        <div class="flex justify-between items-center mb-2">
                            <span class="text-[10px] font-black tracking-widest text-neutral-400">#${order.id}</span>
                            <span class="text-[10px] font-bold text-neutral-600 bg-neutral-100 px-2 py-0.5 rounded flex items-center gap-1">${icon} ${order.mode.toUpperCase()}</span>
                        </div>
                        <p class="font-extrabold text-neutral-900 text-sm">${order.customer}</p>
                        <p class="text-[11px] text-neutral-500 mb-3">${order.location}</p>
                        <div class="space-y-1">
                            ${order.items.map(i => `<div class="text-xs text-neutral-600 font-medium"><span class="font-bold text-neutral-900">${i.qty}x</span> ${i.name}</div>`).join('')}
                        </div>
                        ${actionBtn}
                    </div>`;

                if(order.status === 'pending') document.getElementById('col-pending').innerHTML += cardHTML;
                else if(order.status === 'prep') document.getElementById('col-prep').innerHTML += cardHTML;
                else if(order.status === 'ready') document.getElementById('col-ready').innerHTML += cardHTML;
            });
        }
        function updateOrderStatus(id, newStatus) {
            const order = globalOrders.find(o => o.id === id);
            if(order) { order.status = newStatus; renderAdminDashboard(); if(currentOrderId === id) updateClientTrackingUI(); }
        }

        // Gestor de Menú
        function renderAdminMenuManager() {
            const catContainer = document.getElementById('admin-categories-list'); catContainer.innerHTML = '';
            const selectCat = document.getElementById('prod-category'); selectCat.innerHTML = '';
            
            dbCategories.forEach(cat => {
                catContainer.innerHTML += `<div class="bg-neutral-100 text-neutral-900 px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-2">${cat.name} <button onclick="deleteCategory('${cat.id}')" class="text-neutral-400 hover:text-red-500"><i class="fa-solid fa-times"></i></button></div>`;
                selectCat.innerHTML += `<option value="${cat.id}">${cat.name}</option>`;
            });

            const prodGrid = document.getElementById('admin-products-grid'); prodGrid.innerHTML = '';
            dbMenu.forEach(prod => {
                const catName = dbCategories.find(c => c.id === prod.categoryId)?.name || 'Sin Categoría';
                const imgSrc = prod.img || `https://placehold.co/150x150/f3f4f6/9ca3af?text=No+Foto`;
                prodGrid.innerHTML += `
                    <div class="bg-white border border-neutral-100 rounded-[20px] overflow-hidden flex flex-col hover:border-neutral-200 transition-colors">
                        <div class="h-32 w-full relative"><img src="${imgSrc}" class="w-full h-full object-cover">
                            <div class="absolute top-2 right-2 bg-white/90 backdrop-blur text-neutral-900 text-[9px] font-black px-2 py-0.5 rounded-md">${catName}</div>
                        </div>
                        <div class="p-4 flex-1 flex flex-col">
                            <h4 class="font-extrabold text-sm text-neutral-900">${prod.name}</h4>
                            <p class="text-brand-500 font-black text-sm my-1">$${Number(prod.price).toLocaleString('es-CO')}</p>
                            <div class="flex gap-2 mt-auto pt-3 border-t border-neutral-50">
                                <button onclick="openProductModal('${prod.id}')" class="flex-1 bg-neutral-50 text-neutral-600 py-1.5 rounded-lg text-xs font-bold hover:bg-neutral-100">Editar</button>
                                <button onclick="deleteProduct('${prod.id}')" class="flex-1 bg-red-50 text-red-600 py-1.5 rounded-lg text-xs font-bold hover:bg-red-100">Borrar</button>
                            </div>
                        </div>
                    </div>`;
            });
        }
        function addCategory() {
            const name = document.getElementById('new-category-name').value.trim();
            if(!name) return; dbCategories.push({ id: 'c_' + Date.now(), name: name }); document.getElementById('new-category-name').value = ''; renderAdminMenuManager(); renderClientMenu();
        }
        function deleteCategory(id) { if(confirm('¿Borrar categoría?')) { dbCategories = dbCategories.filter(c => c.id !== id); renderAdminMenuManager(); renderClientMenu(); } }

        function openProductModal(id = null) {
            const modal = document.getElementById('product-modal'); const title = document.getElementById('product-modal-title');
            if(id) {
                title.textContent = 'Editar'; const prod = dbMenu.find(p => p.id === id);
                if(prod) { ['prod-id','prod-name','prod-price','prod-img','prod-desc'].forEach(f => document.getElementById(f).value = prod[f.replace('prod-','')] || ''); document.getElementById('prod-category').value = prod.categoryId; }
            } else {
                title.textContent = 'Crear'; ['prod-id','prod-name','prod-price','prod-img','prod-desc'].forEach(f => document.getElementById(f).value = '');
                if(dbCategories.length > 0) document.getElementById('prod-category').value = dbCategories[0].id;
            }
            modal.classList.remove('hidden');
        }
        function closeProductModal() { document.getElementById('product-modal').classList.add('hidden'); }
        function saveProduct() {
            const id = document.getElementById('prod-id').value; const name = document.getElementById('prod-name').value.trim();
            const price = parseFloat(document.getElementById('prod-price').value); const img = document.getElementById('prod-img').value.trim();
            const desc = document.getElementById('prod-desc').value.trim(); const catId = document.getElementById('prod-category').value;
            if(!name || !price || isNaN(price) || !catId) return alert("Faltan datos");
            if(id) { const i = dbMenu.findIndex(p => p.id === id); if(i > -1) dbMenu[i] = { id, name, price, img, desc, categoryId: catId }; } 
            else { dbMenu.push({ id: 'p_' + Date.now(), name, price, img, desc, categoryId: catId }); }
            closeProductModal(); renderAdminMenuManager(); renderClientMenu(); 
        }
        function deleteProduct(id) { if(confirm('¿Borrar plato?')) { dbMenu = dbMenu.filter(p => p.id !== id); renderAdminMenuManager(); renderClientMenu(); } }

        function paySubscription() { appState.wompiMode = 'subscription'; document.getElementById('wompi-amount').textContent = `$50.000`; document.getElementById('wompi-modal').classList.remove('hidden'); }
        function successSubscriptionPayment() { showModal("¡Éxito!", "Mensualidad renovada.", "fa-solid fa-check", "bg-green-100 text-green-600"); document.getElementById('sub-badge').textContent = "Pagado"; appState.wompiMode = 'order'; }

        // Super Admin (SaaS)
        function renderSuperAdminDashboard() {
            let active = 0; let susp = 0; const table = document.getElementById('saas-restaurants-table'); table.innerHTML = '';
            saasRestaurants.forEach(r => {
                if(r.status === 'active') active++; if(r.status === 'suspended') susp++;
                const statusBadge = r.status === 'active' 
                    ? `<span class="text-[10px] font-bold text-green-400 bg-green-400/10 px-2 py-1 rounded">Activo</span>`
                    : `<span class="text-[10px] font-bold text-red-400 bg-red-400/10 px-2 py-1 rounded">Mora</span>`;
                const actionBtn = r.status === 'active'
                    ? `<button onclick="toggleRestStatus('${r.id}', 'suspended')" class="text-xs text-neutral-500 hover:text-red-400">Suspender</button>`
                    : `<button onclick="toggleRestStatus('${r.id}', 'active')" class="text-xs text-neutral-500 hover:text-green-400">Activar</button>`;
                table.innerHTML += `<tr class="hover:bg-white/[0.02]">
                    <td class="px-6 py-4"><p class="font-bold text-white text-sm">${r.name}</p><p class="text-[10px] text-neutral-500">@${r.user}</p></td>
                    <td class="px-6 py-4 text-xs text-neutral-400">${r.plan}</td><td class="px-6 py-4">${statusBadge}</td><td class="px-6 py-4 text-right">${actionBtn}</td>
                </tr>`;
            });
            document.getElementById('saas-active-count').textContent = active; document.getElementById('saas-suspended-count').textContent = susp;
        }
        function toggleRestStatus(id, stat) { const rest = saasRestaurants.find(r => r.id === id); if(rest) { rest.status = stat; renderSuperAdminDashboard(); } }

        // Inicializar
        renderClientMenu(); updateCartUI();
    </script>
</body>
</html>
